# ==============================================================================
# ASTRA SENTINEL — TACTICAL DEFENCE OSINT & THREAT MONITORING TERMINAL
# Environment Configuration
# ==============================================================================

# Google Gemini API Key
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
# NOTE: If left empty or unset, the system degrades gracefully into deterministic
# rule-based classification mode with clear logging, allowing full offline operation.
GEMINI_API_KEY=

# Persistent SQLite Database Path
# Supports WAL (Write-Ahead Logging) and FTS5 full-text indexing
DB_PATH=data/sentinel.db

# LLM Model Configuration
MODEL_NAME=gemini-2.5-flash

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
